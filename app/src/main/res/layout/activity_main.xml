<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Inasoma SMS za miamala na kuzituma kwenye PesaFlow yako."
            android:textColor="@color/ink2" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_warn"
            android:padding="14dp"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/permBtn"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ruhusu kusoma SMS" />

        <!-- Kabla ya kuunganisha -->
        <LinearLayout
            android:id="@+id/pairSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pairing code"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/codeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="PESAFLOW1.…"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textMultiLine"
                android:minLines="3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pasteBtn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Bandika" />

                <Button
                    android:id="@+id/pairBtn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Unganisha" />
            </LinearLayout>
        </LinearLayout>

        <!-- Baada ya kuunganisha -->
        <LinearLayout
            android:id="@+id/pairedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/server"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/syncBtn"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tuma sasa" />

            <Button
                android:id="@+id/historyBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/history_btn" />

            <Button
                android:id="@+id/openWebBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fungua dashboard" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Watumaji wengine wa SMS za fedha"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mf. jina la SACCOS au benki ndogo, tenganisha kwa koma."
                android:textColor="@color/ink2"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/sendersInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="MWALIMU SACCOS, MKOMBOZI"
                android:importantForAutofill="no"
                android:inputType="text" />

            <Button
                android:id="@+id/saveSendersBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hifadhi watumaji" />

            <Button
                android:id="@+id/unpairBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ondoa muunganisho"
                android:textColor="@color/crit" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Faragha: SMS za watu binafsi na matangazo hazitumwi kamwe. App hii haiwezi kutuma pesa na haihitaji PIN yako."
            android:textColor="@color/ink2"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
